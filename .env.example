# Local CLI/process configuration reference. Keep real values out of Git.
# The owned launcher creates its database URL, worker token, and credential key
# in a mode-0600 settings file. Do not source placeholders into a running setup.
RUNNELIX_DATABASE_URL=postgresql://USER@127.0.0.1:PORT/DATABASE
RUNNELIX_WORKER_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
RUNNELIX_CREDENTIAL_KEY=REPLACE_WITH_64_HEX_CHARACTERS
RUNNELIX_NODE_SERVICE_URL=http://127.0.0.1:8788
TEMPORAL_ADDRESS=127.0.0.1:7233
# Development is unauthenticated and loopback-only. For OIDC, use the session guide.
RUNNELIX_AUTH_MODE=development
# RUNNELIX_AUTH_MODE=oidc
# RUNNELIX_OIDC_ISSUER=https://issuer.example
# RUNNELIX_OIDC_CLIENT_ID=REGISTERED_PUBLIC_CLIENT
# RUNNELIX_BROWSER_ORIGIN=http://127.0.0.1:5173
# RUNNELIX_OIDC_REDIRECT_URL=http://127.0.0.1:5173/v1/auth/callback
# RUNNELIX_DEV_OIDC_LOOPBACK=1  # Only for the local fake issuer.
# RUNNELIX_EGRESS_HOSTS=approved-provider.example
