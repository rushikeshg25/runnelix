  "components": {
    "schemas": {
      "Graph": {
        "$ref": "./workflow.schema.json"
      },
      "Plan": {
        "$ref": "./plan.schema.json"
      },
      "Workflow": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "graph": {
            "$ref": "#/components/schemas/Graph"
          },
          "activeVersionId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "revision",
          "graph",
          "activeVersionId"
        ]
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "workflowId": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "draftRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "graph": {
            "$ref": "#/components/schemas/Graph"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "digest": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workflowId",
          "sequence",
          "draftRevision",
          "graph",
          "plan",
          "digest"
        ]
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string"
          },
          "workflowId": {
            "type": "string"
          },
          "workflowVersionId": {
            "type": "string"
          },
          "state": {
            "const": "accepted"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "runtimeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "dispatchState": {
            "enum": [
              "pending",
              "receipt_recorded",
              "acknowledged"
            ]
          }
        },
        "required": [
          "runId",
          "workflowId",
          "workflowVersionId",
          "state",
          "acceptedAt",
          "runtimeId",
          "dispatchState"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "Validated": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          }
        },
        "required": [
          "revision",
          "digest",
          "plan"
        ]
      },
      "Catalog": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
