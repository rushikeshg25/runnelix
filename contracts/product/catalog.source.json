  {
    "type": "github.createIssue",
    "version": 1,
    "kind": "action",
    "title": "GitHub \u00b7 Create issue",
    "inputs": [
      "in"
    ],
    "outputs": [
      "out"
    ],
    "retrySafety": "unsafe",
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repository",
        "credentialRef"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        },
        "credentialRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "body": {
          "type": "string",
          "maxLength": 6000
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "url"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "httpPolicy": {
      "method": "POST",
      "url": "https://api.github.com/repos/{owner}/{repository}/issues",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "Runnelix"
      },
      "credentialRequired": true
    }
  },
  {
    "type": "slack.postMessage",
    "version": 1,
    "kind": "action",
    "title": "Slack \u00b7 Post message",
    "inputs": [
      "in"
    ],
    "outputs": [
      "out"
    ],
    "retrySafety": "unsafe",
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "credentialRef"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "pattern": "^[CGD][A-Z0-9]+$",
          "maxLength": 80
        },
        "credentialRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "ts"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "pattern": "^[CGD][A-Z0-9]+$",
          "maxLength": 80
        },
        "ts": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "maxLength": 40
        }
      }
    },
    "httpPolicy": {
      "method": "POST",
      "url": "https://slack.com/api/chat.postMessage",
      "credentialRequired": true
    }
  }
