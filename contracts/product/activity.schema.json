{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "type":"object", "additionalProperties":false,
 "required":["contractVersion","workspaceId","runId","nodeId","invocationId","nodeType","nodeVersion","implementationDigest","inputRef","configRef","logicalActionKey"],
 "properties":{
  "contractVersion":{"const":1},
  "workspaceId":{"$ref":"#/definitions/id"},"runId":{"$ref":"#/definitions/id"},"nodeId":{"$ref":"#/definitions/id"},"invocationId":{"$ref":"#/definitions/id"},
  "nodeType":{"type":"string","minLength":1,"maxLength":80},"nodeVersion":{"type":"integer","minimum":1,"maximum":1000000},
  "implementationDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
  "inputRef":{"$ref":"#/definitions/id"},"configRef":{"$ref":"#/definitions/id"},
  "logicalActionKey":{"type":"string","minLength":1,"maxLength":256}
 },
 "definitions":{"id":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,127}$"}}
}
