{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runnelix.local/contracts/workflow-v1",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "nodes", "edges"],
  "properties": {
    "formatVersion": {"const": 1},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/definitions/node"}},
    "edges": {"type": "array", "maxItems": 200, "items": {"$ref": "#/definitions/edge"}}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "version", "config"],
      "properties": {"id": {"$ref": "#/definitions/id"}, "type": {"type": "string", "maxLength": 80}, "version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "config": {"type": "object", "maxProperties": 64}}
    },
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["node", "port"], "properties": {"node": {"$ref": "#/definitions/id"}, "port": {"$ref": "#/definitions/id"}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "#/definitions/endpoint"}, "to": {"$ref": "#/definitions/endpoint"}}}
  }
}
